<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#018577"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="140dp"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <Button
            android:id="@+id/btn_edit_map"
            android:layout_width="260dp"
            android:layout_height="56dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/btn_start_menu"
            android:text="@string/btn_edit_map"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_select_map"
            android:layout_width="260dp"
            android:layout_height="56dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/btn_start_menu"
            android:text="@string/btn_select_map"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_import_map"
            android:layout_width="260dp"
            android:layout_height="56dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/btn_start_menu"
            android:text="@string/btn_import_map"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_delete_map"
            android:layout_width="260dp"
            android:layout_height="56dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/btn_start_menu"
            android:text="@string/btn_delete_map"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_import_txt"
            android:layout_width="260dp"
            android:layout_height="56dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/btn_start_menu"
            android:text="@string/btn_import_txt"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_scale_map"
            android:layout_width="260dp"
            android:layout_height="56dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/btn_start_menu"
            android:text="@string/btn_scale_map"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_export_map"
            android:layout_width="260dp"
            android:layout_height="56dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/btn_start_menu"
            android:text="@string/btn_export_map"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_language"
            android:layout_width="260dp"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/btn_start_menu"
            android:text="@string/btn_language"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>

    </ScrollView>

</RelativeLayout>
